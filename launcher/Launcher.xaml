<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Marvel Heroes Omega" Width="1140" Height="800" MinWidth="1000" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#000000" Foreground="#F4F1E8" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Window.Resources>
  <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0.85,1"><GradientStop Color="#E0101113" Offset="0"/><GradientStop Color="#F0050506" Offset="0.5"/><GradientStop Color="#FC000000" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0.6,1"><GradientStop Color="#9CCDDCE5" Offset="0"/><GradientStop Color="#3A9BA8B8" Offset="0.35"/><GradientStop Color="#504A4130" Offset="0.8"/><GradientStop Color="#6098A4B5" Offset="1"/></LinearGradientBrush>
  <Style x:Key="GlassCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource GlassFill}"/><Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="17"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity="0.35"/></Setter.Value></Setter></Style>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#E6D29D"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#8018191B" Offset="0"/><GradientStop Color="#F0050505" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="BorderBrush" Value="#657B7D80"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#252525"/><Setter TargetName="Surface" Property="BorderBrush" Value="#3B3B3B"/><Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="#888888"/><Setter Property="Effect" Value="{x:Null}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="178"/><RowDefinition Height="134"/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <Border Grid.Row="0" BorderBrush="#332D20" BorderThickness="0,0,0,1">
   <Grid Margin="30,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="MARVEL HEROES" Foreground="#D4AF62" FontSize="23" FontWeight="Bold"/><TextBlock Text="O M E G A   /   C O M M U N I T Y   L A U N C H E R" FontSize="9" Foreground="#8D8678" Margin="1,4,0,0"/></StackPanel>
    <Border x:Name="UpdateNotice" Grid.Column="1" Background="#D4AF62" CornerRadius="10" Padding="12,7" VerticalAlignment="Center" Margin="0,0,18,0" Visibility="Collapsed"><TextBlock Text="UPDATE AVAILABLE" Foreground="#000000" FontSize="11" FontWeight="Bold"/></Border>
    <Button x:Name="SettingsButton" Grid.Column="2" Content="Game settings" Margin="0,18,12,18"/>
    <Button x:Name="AccountButton" Grid.Column="3" Content="Create account" Margin="0,18,0,18"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1" ClipToBounds="True">
   <Image x:Name="HeroImage" Stretch="UniformToFill" HorizontalAlignment="Stretch" RenderOptions.BitmapScalingMode="HighQuality"/>
   <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF000000" Offset="0"/><GradientStop Color="#C0000000" Offset="0.23"/><GradientStop Color="#18000000" Offset="0.47"/><GradientStop Color="#00000000" Offset="0.65"/></LinearGradientBrush></Border.Background></Border>
   <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.82"/><GradientStop Color="#FF000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
   <StackPanel Margin="40,26,0,24" VerticalAlignment="Center" HorizontalAlignment="Left" Width="380">
    <TextBlock Text="THE HEROES RETURN" Foreground="#D4AF62" FontSize="11" FontWeight="Bold" Margin="2,0,0,13"/>
    <TextBlock Text="ASSEMBLE.&#10;AGAIN." FontSize="51" FontWeight="Bold" LineHeight="51" LineStackingStrategy="BlockLineHeight"/>
    <Rectangle Fill="#D4AF62" Width="54" Height="3" HorizontalAlignment="Left" Margin="3,21,0,17"/>
    <TextBlock Text="Your heroes. Your world.&#10;Return to the fight in Marvel Heroes Omega." Foreground="#B8B6B0" FontSize="14" LineHeight="23"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2" Grid.RowSpan="2" ClipToBounds="True" IsHitTestVisible="False">
   <Image Source="{Binding Source, ElementName=HeroImage}" Stretch="UniformToFill" Opacity="0.08"><Image.Effect><BlurEffect Radius="45"/></Image.Effect></Image>
   <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#80000000" Offset="0"/><GradientStop Color="#E0000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <Ellipse Width="580" Height="145" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-130,0,0,0" Opacity="0.08"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#ADCDE4" Offset="0"/><GradientStop Color="#00ADCDE4" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
   <Ellipse Width="500" Height="240" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-60,-75" Opacity="0.08"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#D4AF62" Offset="0"/><GradientStop Color="#00D4AF62" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
  </Grid>
  <Grid Grid.Row="2" Margin="32,4,32,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="UpdateCard" Style="{StaticResource GlassCard}"><Grid Margin="20,17"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="UpdateHeading" Text="LATEST UPDATES" Foreground="#D4AF62" FontSize="10" FontWeight="Bold"/>
    <TextBlock x:Name="UpdateSummary" Grid.Row="1" Text="Checking for launcher and game updates…" FontSize="16" Margin="0,10,0,8"/>
    <Button x:Name="UpdateButton" Grid.Row="2" Content="Check for updates" HorizontalAlignment="Left" Padding="14,7" FontSize="11"/>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource GlassCard}"><Grid Margin="20,17"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="YOUR GAME LIBRARY" Foreground="#D4AF62" FontSize="10" FontWeight="Bold"/>
    <TextBlock x:Name="GameLocation" Grid.Row="1" Text="Choose where your heroes live." FontSize="13" Foreground="#CCD0D6" Margin="0,10,0,8" TextTrimming="CharacterEllipsis"/>
    <WrapPanel Grid.Row="2"><Button x:Name="FolderButton" Content="Choose folder" Padding="12,7" FontSize="11" Margin="0,0,8,0"/><Button x:Name="LocateButton" Content="Locate existing game" Padding="12,7" FontSize="11" Margin="0,0,8,0"/><Button x:Name="RepairButton" Content="Verify / repair" Padding="12,7" FontSize="11"/></WrapPanel>
   </Grid></Border>
  </Grid>
  <Border Grid.Row="3" Style="{StaticResource GlassCard}" Margin="32,0,32,8">
   <Grid Margin="22,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><Grid><TextBlock x:Name="StatusText" Text="Checking required updates..." FontSize="15" Margin="0,0,65,0"/><TextBlock x:Name="PercentText" HorizontalAlignment="Right" Foreground="#D4AF62" FontSize="12"/></Grid><ProgressBar x:Name="Progress" Height="5" Margin="0,13,0,9" Minimum="0" Maximum="100" Value="0" Foreground="#D4AF62" Background="#292A2F" BorderThickness="0"/><TextBlock x:Name="DetailText" Text="Sign in inside the game. Your account progress stays on the server." Foreground="#ADB3BF" FontSize="11"/></StackPanel>
    <Button x:Name="PlayButton" Grid.Column="2" Content="PLAY" FontSize="23" Foreground="#15130D" BorderBrush="#F5DFAB" Padding="16,16" VerticalAlignment="Center"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F4DEAE" Offset="0"/><GradientStop Color="#D6B467" Offset="0.48"/><GradientStop Color="#B58A3E" Offset="1"/></LinearGradientBrush></Button.Background><Button.Effect><DropShadowEffect Color="#D4AF62" BlurRadius="22" ShadowDepth="0" Opacity="0.22"/></Button.Effect></Button>
   </Grid>
  </Border>
  <Grid Grid.Row="4" Margin="32,0"><TextBlock x:Name="VersionLabel" Text="LAUNCHER 1.1.0" FontSize="9" Foreground="#706D64" VerticalAlignment="Center"/><Button x:Name="ConnectionButton" Content="Server status / Login help" FontSize="11" Padding="12,6" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Unofficial fan launcher  •  Artwork © Marvel Studios" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" Foreground="#706D64"/></Grid>
 </Grid>
</Window>



