<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Marvel Heroes Omega" Width="1140" Height="800" MinWidth="1000" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#090A0D" Foreground="#F4F1E8" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#E6D29D"/><Setter Property="Background" Value="#18191D"/><Setter Property="BorderBrush" Value="#514631"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="178"/><RowDefinition Height="134"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Grid.Row="0" BorderBrush="#332D20" BorderThickness="0,0,0,1">
   <Grid Margin="30,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="MARVEL HEROES" Foreground="#D4AF62" FontSize="23" FontWeight="Bold"/><TextBlock Text="O M E G A   /   C O M M U N I T Y   L A U N C H E R" FontSize="9" Foreground="#8D8678" Margin="1,4,0,0"/></StackPanel>
    <Button x:Name="SettingsButton" Grid.Column="1" Content="Game settings" Margin="0,18,12,18"/>
    <Button x:Name="AccountButton" Grid.Column="2" Content="Create account" Margin="0,18,0,18"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1" ClipToBounds="True">
   <Image x:Name="HeroImage" Stretch="UniformToFill" HorizontalAlignment="Stretch"/>
   <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF090A0D" Offset="0"/><GradientStop Color="#E8090A0D" Offset="0.26"/><GradientStop Color="#50090A0D" Offset="0.61"/><GradientStop Color="#10090A0D" Offset="1"/></LinearGradientBrush></Border.Background></Border>
   <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00090A0D" Offset="0.55"/><GradientStop Color="#FF090A0D" Offset="1"/></LinearGradientBrush></Border.Background></Border>
   <StackPanel Margin="40,26,0,24" VerticalAlignment="Center" HorizontalAlignment="Left" Width="380">
    <TextBlock Text="THE HEROES RETURN" Foreground="#D4AF62" FontSize="11" FontWeight="Bold" Margin="2,0,0,13"/>
    <TextBlock Text="ASSEMBLE.&#10;AGAIN." FontSize="51" FontWeight="Bold" LineHeight="51" LineStackingStrategy="BlockLineHeight"/>
    <Rectangle Fill="#D4AF62" Width="54" Height="3" HorizontalAlignment="Left" Margin="3,21,0,17"/>
    <TextBlock Text="Your heroes. Your world.&#10;Return to the fight in Marvel Heroes Omega." Foreground="#B8B6B0" FontSize="14" LineHeight="23"/>
   </StackPanel>
   <TextBlock x:Name="FilmLabel" Text="AVENGERS: ENDGAME" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,34,25" Foreground="#D2C5A4" FontSize="10"/>
  </Grid>
  <Grid Grid.Row="2" Margin="32,4,32,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#131418" BorderBrush="#302B21" BorderThickness="1" CornerRadius="4"><Grid Margin="20,17"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="LATEST UPDATES" Foreground="#D4AF62" FontSize="10" FontWeight="Bold"/>
    <TextBlock x:Name="UpdateSummary" Grid.Row="1" Text="Checking for launcher and game updates…" FontSize="16" Margin="0,10,0,8"/>
    <Button x:Name="UpdateButton" Grid.Row="2" Content="Check for updates" HorizontalAlignment="Left" Padding="14,7" FontSize="11"/>
   </Grid></Border>
   <Border Grid.Column="2" Background="#131418" BorderBrush="#302B21" BorderThickness="1" CornerRadius="4"><Grid Margin="20,17"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="YOUR GAME LIBRARY" Foreground="#D4AF62" FontSize="10" FontWeight="Bold"/>
    <TextBlock x:Name="GameLocation" Grid.Row="1" Text="Choose where your heroes live." FontSize="13" Foreground="#B8B6B0" Margin="0,10,0,8" TextTrimming="CharacterEllipsis"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal"><Button x:Name="FolderButton" Content="Choose folder" Padding="14,7" FontSize="11" Margin="0,0,8,0"/><Button x:Name="LocateButton" Content="Locate existing game" Padding="14,7" FontSize="11"/></StackPanel>
   </Grid></Border>
  </Grid>
  <Border Grid.Row="3" Background="#111216" BorderBrush="#373023" BorderThickness="0,1,0,1">
   <Grid Margin="32,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><Grid><TextBlock x:Name="StatusText" Text="Ready to assemble." FontSize="15" Margin="0,0,65,0"/><TextBlock x:Name="PercentText" HorizontalAlignment="Right" Foreground="#D4AF62" FontSize="12"/></Grid><ProgressBar x:Name="Progress" Height="5" Margin="0,13,0,9" Minimum="0" Maximum="100" Value="0" Foreground="#D4AF62" Background="#292A2F" BorderThickness="0"/><TextBlock x:Name="DetailText" Text="Sign in inside the game. Your account progress stays on the server." Foreground="#898A8F" FontSize="11"/></StackPanel>
    <Button x:Name="PlayButton" Grid.Column="2" Content="PLAY" FontSize="23" Background="#D4AF62" Foreground="#15130D" BorderBrush="#E6C77F" Padding="16,16" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <Grid Grid.Row="4" Margin="32,0"><TextBlock x:Name="VersionLabel" Text="LAUNCHER 1.1.0" FontSize="9" Foreground="#706D64" VerticalAlignment="Center"/><TextBlock Text="Unofficial fan launcher  •  Artwork © Marvel Studios" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" Foreground="#706D64"/></Grid>
 </Grid>
</Window>
